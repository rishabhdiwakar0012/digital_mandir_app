# Frontend Environment Variables
# Copy this file to .env and fill in your values
# cp .env.example .env

# ─── API ─────────────────────────────────────────────────────────
# Local development: use your machine's local IP (not localhost — Android emulators can't reach it)
# Find your IP: ipconfig (Windows) / ifconfig (Mac/Linux)
EXPO_PUBLIC_API_URL=http://192.168.1.6:3000/api

# ─── Google Sign-In ───────────────────────────────────────────────
# Get from: https://console.cloud.google.com
#   → APIs & Services → Credentials → Create OAuth 2.0 Client IDs
#   Note: Web Client ID is required; iOS/Android IDs are optional but recommended
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=xxxxxxxxxxxx-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx.apps.googleusercontent.com
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=xxxxxxxxxxxx-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx.apps.googleusercontent.com
EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=xxxxxxxxxxxx-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx.apps.googleusercontent.com

# ─── Expo ─────────────────────────────────────────────────────────
# Prevent Expo from using the monorepo root as Metro's server root
EXPO_NO_METRO_WORKSPACE_ROOT=1

# ─── Environment ──────────────────────────────────────────────────
NODE_ENV=development

# ─── Network ──────────────────────────────────────────────────────
API_TIMEOUT=30000
