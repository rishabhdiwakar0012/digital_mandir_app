# Environment Variables
# Copy this file to .env and fill in your values
# cp .env.example .env

# ─── Application ────────────────────────────────────────────────
NODE_ENV=development
PORT=3000
API_PREFIX=api

# ─── JWT — CHANGE THESE IN PRODUCTION! ─────────────────────────
JWT_SECRET=your-super-secret-key-change-this-in-production-minimum-32-chars
JWT_ACCESS_EXPIRATION=15m
JWT_REFRESH_EXPIRATION=7d

# ─── Throttling ─────────────────────────────────────────────────
THROTTLE_TTL=60000
THROTTLE_LIMIT=100

# ─── CORS ───────────────────────────────────────────────────────
# Comma-separated origins for production, e.g. https://digitalmandir.in
CORS_ORIGIN=*

# ─── MongoDB ────────────────────────────────────────────────────
MONGODB_URI=mongodb://localhost:27017/mantra_jaap

# ─── Admin Credentials (seeds first admin on startup) ───────────
ADMIN_EMAIL=admin@digitalmandir.in
ADMIN_PASSWORD=Admin@123
ADMIN_PHONE=+919999999999

# ─── Google OAuth (Google Sign-In) ──────────────────────────────
# Get from: https://console.cloud.google.com
#   → APIs & Services → Credentials → Create OAuth 2.0 Client IDs
#   Create 3 clients: Web Application, iOS, Android
GOOGLE_CLIENT_ID=xxxxxxxxxxxx-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=GOCSPX-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
GOOGLE_IOS_CLIENT_ID=xxxxxxxxxxxx-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx.apps.googleusercontent.com
GOOGLE_ANDROID_CLIENT_ID=xxxxxxxxxxxx-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx.apps.googleusercontent.com

# ─── Firebase Cloud Messaging (Push Notifications) ──────────────
# Get from: https://console.firebase.google.com
#   → Project Settings → Service Accounts → Generate new private key
#   Download the JSON file and copy these 3 values from it
FCM_PROJECT_ID=your-firebase-project-id
FCM_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your-project.iam.gserviceaccount.com
# Paste the private key exactly as-is — newlines must be written as \n
FCM_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----\nMIIEowIBAAKCAQEA...\n-----END RSA PRIVATE KEY-----\n"

# ─── SMS Provider ────────────────────────────────────────────────
# Options: console (prints to terminal) | twilio
SMS_PROVIDER=console
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# ─── Email Provider ──────────────────────────────────────────────
# Options: console (prints to terminal) | smtp | sendgrid
EMAIL_PROVIDER=console
EMAIL_FROM=noreply@digitalmandir.in
# SMTP settings (if EMAIL_PROVIDER=smtp)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
# SendGrid (if EMAIL_PROVIDER=sendgrid)
SENDGRID_API_KEY=

# ─── Redis (optional — for session/cache) ───────────────────────
REDIS_HOST=localhost
REDIS_PORT=6379
