{
  "name": "digital-mandir",
  "version": "1.0.3",
  "private": true,
  "description": "Digital Mandir - Full Stack Application",
  "workspaces": [
    "backend",
    "frontend",
    "shared",
    "landing",
    "admin"
  ],
  "scripts": {
    "backend:dev": "cd backend && npm run start:dev",
    "backend:build": "cd backend && npm run build",
    "backend:start": "cd backend && npm run start:prod",
    "frontend:dev": "cd frontend && npm start",
    "frontend:web": "cd frontend && npm run web",
    "frontend:android": "cd frontend && npm run android",
    "frontend:ios": "cd frontend && npm run ios",
    "shared:build": "cd shared && npm run build",
    "install:all": "npm install && cd backend && npm install && cd ../frontend && npm install && cd ../shared && npm install && cd ../admin && npm install",
    "dev": "node init && concurrently \"npm run backend:dev\" \"npm run frontend:dev\"",
    "admin:dev": "cd admin && npm run dev",
    "admin:build": "cd admin && npm run build",
    "admin:start": "cd admin && npm run start",
    "lint": "cd backend && npm run lint && cd ../frontend && npm run lint",
    "android": "expo run:android",
    "ios": "expo run:ios"
  },
  "devDependencies": {
    "concurrently": "^8.2.0"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "dependencies": {
    "lodash": "^4.17.23",
    "prop-types": "^15.8.1",
    "react": "19.1.0",
    "xdate": "^0.8.3"
  },
  "overrides": {
    "react": "19.1.0",
    "react-dom": "19.1.0"
  }
}
